{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SkillLatch action request (exactly one of the three kind branches). Documentation-grade: the reference parser in skilllatch/core.py is authoritative. Known looseness vs the parser: (1) the RELPATH pattern does not reject Windows device names or components with a trailing space or dot; (2) the network branch checks only a coarse https pattern, not the parser's full host rules (HTTPS scheme, ASCII/punycode, DNS label shape, IPv4 canonical dotted-quad, IPv6 canonicalization, port rules, host length), and the parser matches only the normalized origin, discarding path and query; (3) the workspace filesystem checks for file requests (link/reparse traversal, escape, hard links) are not expressible; (4) duplicate object keys and nonfinite numbers are invisible to JSON Schema.",
  "oneOf": [
    {
      "type": "object",
      "required": ["session_id", "task_id", "kind", "action", "path"],
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
        },
        "kind": {"const": "file"},
        "action": {"enum": ["read", "write"]},
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*//)(?!.*/$)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\:*?<>|\"\\u0000-\\u001F\\u007F]+$"
        }
      }
    },
    {
      "type": "object",
      "required": ["session_id", "task_id", "kind", "url"],
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
        },
        "kind": {"const": "network"},
        "url": {"type": "string", "minLength": 1, "pattern": "^https://[^\\s#]+$"}
      }
    },
    {
      "type": "object",
      "required": ["session_id", "task_id", "kind", "argv"],
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
        },
        "kind": {"const": "command"},
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
          }
        }
      }
    }
  ]
}
